class SyllabusTab extends StatefulWidget {
  const SyllabusTab({super.key});
  @override
  State<SyllabusTab> createState() => _Y();
}

class _Y extends State<SyllabusTab> {
  Set<String> done = {};
  SharedPreferences? sp;

  @override
  void initState() {
    super.initState();
    SharedPreferences.getInstance().then((s) {
      sp = s;
      setState(() => done = (s.getStringList('done') ?? []).toSet());
    });
  }

  bool d(String s, String c) => done.contains('$s/$c');

  @override
  Widget build(BuildContext c) {
    final all = syl.values.fold<int>(0, (a, l) => a + l.length);
    return Scaffold(
      body: SafeArea(
        child: ListView(children: [
          Padding(
            padding: const EdgeInsets.all(16),
            child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
              Text('Syllabus: ${(done.length * 100 / all).round()}% complete'),
              const SizedBox(height: 8),
              LinearProgressIndicator(value: done.length / all),
            ]),
          ),
          for (final e in syl.entries)
            ExpansionTile(
              title: Text('${e.key}  ${e.value.where((x) => d(e.key, x)).length}/${e.value.length}'),
              children: [
                for (final ch in e.value)
                  CheckboxListTile(
                    title: Text(ch),
                    value: d(e.key, ch),
                    onChanged: (v) {
                      setState(() {
                        if (v == true) {
                          done.add('${e.key}/$ch');
                        } else {
                          done.remove('${e.key}/$ch');
                        }
                      });
                      sp?.setStringList('done', done.toList());
                    },
                  ),
              ],
            ),
        ]),
      ),
    );
  }
}
